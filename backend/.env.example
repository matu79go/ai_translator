# ── Fully local meeting assist (/#meeting) ─────────────────────────────
# Address of the GPU machine running vLLM (Gemma 4) and the Nemotron ASR server.
# 127.0.0.1 if the backend runs on the same machine. The two URLs below default from it.
GX10_HOST=127.0.0.1
# GX10_BASE_URL=http://127.0.0.1:8001/v1
# NEMOTRON_ASR_URL=ws://127.0.0.1:8092/ws
# GX10_MODEL=gemma4-26b-a4b

# ── Optional: cloud services ────────────────────────────────────────────
# Deepgram: only if you switch the ASR to Deepgram (meeting assist), or for the v1 UI at /
# Get your API key from https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API Key (v1 UI only, for GPT-4 model)
# Get your API key from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Google API Key (optional, for Gemini model)
# Get your API key from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key (optional, for Groq model)
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Ollama Base URL (optional, for Gemma model via Ollama)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# LM Studio Base URL (optional, for LM Studio model)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=gemma-3-4b-it
