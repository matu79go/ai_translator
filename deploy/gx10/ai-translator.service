[Unit]
Description=ai_translator meeting assist (uvicorn 127.0.0.1:8100 -> tailscale serve :10443)
After=network-online.target nemotron-asr.service

[Service]
WorkingDirectory=%h/ai_translator/backend
ExecStart=%h/ai_translator/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8100
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
